{
  "name": "highlightdiff",
  "displayName": "Highlight Diff",
  "description": "Highlights lines changed in the current branch compared to a target branch",
  "version": "0.8.0",
  "publisher": "highlightdiff",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "highlightdiff.toggle",
        "title": "Highlight Diff: Toggle"
      },
      {
        "command": "highlightdiff.setTargetBranch",
        "title": "Highlight Diff: Set Target Branch"
      },
      {
        "command": "highlightdiff.refresh",
        "title": "Highlight Diff: Refresh"
      },
      {
        "command": "highlightdiff.viewAsTree",
        "title": "View as Tree",
        "icon": "$(list-tree)"
      },
      {
        "command": "highlightdiff.viewAsList",
        "title": "View as List",
        "icon": "$(list-flat)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "highlightdiff.viewAsTree",
          "when": "view == highlightdiff.changedFiles && !highlightdiff.treeView",
          "group": "navigation"
        },
        {
          "command": "highlightdiff.viewAsList",
          "when": "view == highlightdiff.changedFiles && highlightdiff.treeView",
          "group": "navigation"
        }
      ]
    },
    "views": {
      "scm": [
        {
          "id": "highlightdiff.changedFiles",
          "name": "Branch Changes"
        }
      ]
    },
    "configuration": {
      "title": "Highlight Diff",
      "properties": {
        "highlightdiff.targetBranch": {
          "type": "string",
          "default": "auto",
          "description": "The branch to diff against. Set to 'auto' to detect from PR or remote tracking."
        },
        "highlightdiff.addedColor": {
          "type": "string",
          "format": "color",
          "default": "#00ff001a",
          "description": "Color for added/modified lines"
        },
        "highlightdiff.deletedColor": {
          "type": "string",
          "format": "color",
          "default": "#ff000033",
          "description": "Color for deleted lines"
        },
        "highlightdiff.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Whether highlights are active"
        },
        "highlightdiff.decorationStyle": {
          "type": "string",
          "default": "background",
          "enum": ["background", "gutter", "border", "overview-ruler"],
          "description": "How changed lines are visually indicated"
        },
        "highlightdiff.blameFontStyle": {
          "type": "string",
          "default": "normal",
          "enum": ["italic", "normal"],
          "description": "Font style for inline git blame text"
        },
        "highlightdiff.blameColor": {
          "type": "string",
          "format": "color",
          "default": "",
          "description": "Color for inline git blame text. Leave empty to use the editor's code lens color."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^18.0.0",
    "typescript": "^5.0.0"
  }
}
